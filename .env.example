# Copia este archivo como ".env" (sin la palabra example) y pega tu clave.
# El archivo .env NO se sube a GitHub: nunca publiques tu clave.

# Clave gratuita de Google AI Studio: https://aistudio.google.com/apikey
IA_API_KEY=

# Valores por defecto (Gemini). Cámbialos solo si usas otro servicio.
IA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
IA_MODELO=gemini-3.5-flash-lite

# Alternativas compatibles (descomenta y ajusta):
# Groq:   IA_BASE_URL=https://api.groq.com/openai/v1
# Ollama: IA_BASE_URL=http://localhost:11434/v1   (sin clave; IA_MODELO=el modelo que tengas)
